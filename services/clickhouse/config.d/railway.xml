<!--
  Railway overrides for AiSOC's single-node ClickHouse (merged over the image's
  default config.xml; the image's docker_related_config.xml keeps listening on
  :: and 0.0.0.0, so the server is reachable over IPv6 and IPv4).

  - Logs to the console only (Railway collects stdout); no log files on disk.
  - Only HTTP (8123) and native (9000) are used, on the private network. The
    inter-server, MySQL and PostgreSQL wire-protocol ports are switched off.
  - Smaller caches than the defaults, which assume a large dedicated host.
  - Drops high-churn system log tables AiSOC does not read.
-->
<clickhouse>
    <logger replace="1">
        <level>warning</level>
        <console>1</console>
    </logger>

    <interserver_http_port remove="1"/>
    <mysql_port remove="1"/>
    <postgresql_port remove="1"/>

    <mark_cache_size>268435456</mark_cache_size>
    <uncompressed_cache_size>134217728</uncompressed_cache_size>
    <max_server_memory_usage_to_ram_ratio>0.8</max_server_memory_usage_to_ram_ratio>

    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <processors_profile_log remove="1"/>
</clickhouse>
